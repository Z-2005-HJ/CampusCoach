# 本文件只展示变量名称和占位值，不包含可用密钥。
# 第 1 步尚未建立配置加载代码；后续步骤不得把本文件直接当作生产配置。

APP_NAME=CampusCoach
APP_ENV=development
LOG_LEVEL=INFO

# 数据库配置为后续阶段预留；当前没有数据库服务。
DATABASE_URL=postgresql+asyncpg://replace_user:replace_password@localhost:5432/campuscoach

# 会话和签名密钥只能通过本地未提交的 .env 或服务端环境变量提供。
SECRET_KEY=replace_with_local_development_secret

# 模型接入按产品阶段八处理；当前应保持禁用。
MODEL_PROVIDER=disabled
MODEL_API_KEY=replace_on_server_only
MODEL_NAME=replace_model_name

# S3 兼容对象存储为后续阶段预留。
S3_ENDPOINT=replace_object_storage_endpoint
S3_BUCKET=replace_private_bucket
S3_ACCESS_KEY=replace_access_key
S3_SECRET_KEY=replace_secret_key

# 观测服务为后续阶段预留。
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
